# Docker Compose environment for GPlayNation.
# Copy this file to .env.docker and fill in APP_KEY before deploying.
# This file is read by the app/queue/scheduler containers, not by Laravel's
# local (non-Docker) `.env`.

APP_NAME=GPlayNation
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=http://localhost:8001

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# SQLite lives inside the persisted storage volume. WAL + busy timeout let the
# web, queue, and scheduler processes share it on a single host.
DB_CONNECTION=sqlite
DB_DATABASE=/var/www/html/storage/app/database.sqlite
DB_BUSY_TIMEOUT=5000
DB_JOURNAL_MODE=wal
DB_SYNCHRONOUS=normal

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

MAIL_MAILER=log
MAIL_FROM_ADDRESS=hello@gplaynation.test
MAIL_FROM_NAME=GPlayNation

GPN_PAYMENT_SERVER_KEY=replace-with-a-long-random-secret
GPN_TRX_TTL_HOURS=24

# Run pending migrations and rebuild Laravel's caches when gpn-serve starts.
# Set RUN_MIGRATIONS=false if you run releases separately.
RUN_BOOTSTRAP=true
RUN_MIGRATIONS=true
RUN_OPTIMIZE=true
